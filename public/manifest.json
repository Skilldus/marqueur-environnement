{
  "manifest_version": 3,
  "name": "Indicateur d'Environnement",
  "version": "1.0",
  "description": "Affiche un bandeau selon des regex d'URL configurables.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/banner.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}